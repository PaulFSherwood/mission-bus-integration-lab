# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# MBIL runtime exchange files - generated at run time
/data/exchange/*
!/data/exchange/.gitkeep
!/data/exchange/README.md

# MBIL DIS captures/replays - can get large and should not go to GitHub
/data/dis_captures/*
!/data/dis_captures/.gitkeep
!/data/dis_captures/README.md

# MBIL logs and generated output
/data/out/*
/data/logs/*
*.log
*.jsonl

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
